rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tüm koleksiyonlar için genel kural
    match /{document=**} {
      // Okuma (Read): Giriş yapmamış ziyaretçiler dahil herkese açık
      allow read: if true;
      
      // Oluşturma (Create): Yalnızca doğrulanmış/giriş yapmış kullanıcılar
      allow create: if request.auth != null;
      
      // Güncelleme/Silme (Update/Delete): Sadece belgenin sahibi olan kullanıcı
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.authorId || 
        request.auth.uid == resource.data.uid
      );
    }
  }
}
